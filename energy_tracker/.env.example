# Settings and secrets. The real file is .env, which is never committed to Git.
# Easiest way to create it:  bash scripts/init-env.sh

# Home Assistant address. Use the IP address, not homeassistant.local:
# containers can't resolve .local names.
HA_URL=http://192.168.1.50:8123

# Long-lived access token: Home Assistant > your profile > Security tab.
HA_TOKEN=paste-token-here

# How often to poll Home Assistant, in seconds (minimum 10).
POLL_SECONDS=60
